# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# config
config.json

# Parlor generated images
/data/parlor/

# Mirrored LoL challenge tier tokens (~93MB, populated by
# `npm run mirror-challenge-icons`; regenerable, never committed).
/public/lol/challenge-tokens/
/public/lol/challenge-shared/

# Paddle Planner raw Ontario open-data pulls (regenerable via
# `npm run sync-paddle -- --refetch`; ~50MB per park).
/.cache/

# Village viewer texture atlas — derived from MineColonies (All Rights Reserved)
# and Mojang assets. Local-only, never commit, never serve outside localhost.
/public/village/
